# Optional Compose overrides. A fresh clone also works without a .env file.
# These are public, local-development credentials, never production secrets.
MYSQL_DATABASE=fourlane_auction
MYSQL_USER=fourlane
MYSQL_PASSWORD=fourlane_local_password
MYSQL_ROOT_PASSWORD=fourlane_local_root_password
MYSQL_PORT=3306

# Export these to the bootRun process when changing backend defaults.
MYSQL_HOST=127.0.0.1
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
WS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Read only by vite.config.ts; never exposed as a VITE_* client variable.
BACKEND_PROXY_TARGET=http://127.0.0.1:8080
