# Copy to /opt/fourlane/.env on the server. Do not commit actual credentials.
# Select exactly one published image tag: sha-<40-character commit> or v0.1.0.
IMAGE_TAG=
MYSQL_DATABASE=fourlane_auction
DB_USERNAME=fourlane
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE and the database name at the end of DB_URL must match.
# This is the private Compose service hostname, not the EC2 public hostname.
DB_URL=jdbc:mysql://mysql:3306/fourlane_auction?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&sslMode=DISABLED
# Exact browser origin: scheme + hostname + optional port, no path/trailing slash.
WS_ALLOWED_ORIGINS=http://auction.example.com
APP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=80
